# Optional: route the Next.js API layer through your own apimanga proxy-cache API.
# Local apimanga testing:
COMIC_API_BASE_URL=http://127.0.0.1:4000

# Production example after apimanga is deployed on Azure:
# COMIC_API_BASE_URL=http://YOUR_AZURE_VM_IP
# COMIC_API_BASE_URL=https://api.your-domain.com

# Optional fallback/direct upstream override. If this is set, it takes priority over COMIC_API_BASE_URL.
# Keep this empty when you want to use apimanga.
# SANKA_API_BASE_URL=https://www.sankavollerei.web.id
